{
  "name": "buildplate",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local-first mesh+CAD MCP for agents — Hunyuan/TripoSR and agent-authored CSG on your Mac or PC",
  "bin": {
    "buildplate": "./mcp/server.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup-worker.mjs",
    "postinstall": "npm install --prefix preview --ignore-scripts",
    "worker": "node scripts/start-worker.mjs",
    "mcp": "node mcp/server.mjs",
    "preview": "npm run dev --prefix preview",
    "preview:build": "npm run build --prefix preview",
    "start": "concurrently -n worker,preview -c magenta,cyan \"npm:worker\" \"npm:preview\"",
    "dev": "npm start"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "open": "^10.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
