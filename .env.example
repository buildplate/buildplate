# Environment (optional — defaults are localhost + ~/buildplate)

# BUILDPLATE_HOME=~/buildplate
# BUILDPLATE_PREVIEW_URL=http://buildplate.localhost
# Windows: omitted — MCP/preview fall back to http://localhost:3920 when
# buildplate.localhost does not resolve (no hosts entry needed).
# BUILDPLATE_WORKER_HOST=127.0.0.1
# BUILDPLATE_WORKER_PORT=8081
# BUILDPLATE_OUT_DIR=~/buildplate/out
# BUILDPLATE_CACHE=~/buildplate/cache
# BUILDPLATE_VENDOR=~/buildplate/vendor
# BUILDPLATE_VENV=~/buildplate/venv
# BUILDPLATE_BACKEND=triposr
# BUILDPLATE_ALLOW_STUB=0
# BUILDPLATE_PYTHON=/opt/homebrew/bin/python3.12
